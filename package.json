{
  "name": "fixlark-agent-desk",
  "version": "0.1.0",
  "description": "AI work that agents can buy, paid only on delivery: PayPal authorize, verify, then capture.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo:tts": "node --env-file-if-exists=.env --import tsx src/cli/tts-roundtrip.ts",
    "start": "node --env-file-if-exists=.env --no-warnings --import tsx src/main.ts",
    "dev:scripted": "node --no-warnings --import tsx test/dev-scripted.ts",
    "e2e": "node --no-warnings --import tsx test/e2e.live.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pngjs": "6.0.5",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ag-grid-community": "36.2.0",
    "hono": "4.13.13",
    "pngjs": "7.0.0",
    "tsx": "4.20.3",
    "zod": "4.6.7"
  }
}
