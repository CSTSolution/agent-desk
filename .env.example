# Copy to .env and fill in. Never commit .env.

# The AI tools Agent Desk sells. Fixlark's public API needs no key and has per-visitor limits.
FIXLARK_API=https://fixlark.com/api/v1

# Any OpenAI-compatible endpoint. Default: NVIDIA Nemotron on build.nvidia.com (key starts nvapi-).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_ROUTER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Set to 0 if your provider rejects chat_template_kwargs (reasoning on/off).
LLM_THINKING_CONTROL=1

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox).
# When both are set, Agent Desk takes real sandbox payments; otherwise it uses the demo wallet.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD

# Server
PORT=8787
DATA_DIR=data

# Who may register: "code:cents-per-account:max-accounts,...". Give the code out; never commit it.
INVITE_CODES=
# Optional operator codes for the API only: "code:cents,..."
ACCESS_CODES=
# PayPal sandbox test buyers shown to signed-in users. Single quotes keep any $ literal.
SANDBOX_BUYERS='email|password'

# Guard: model budget per day in US cents across all users, and a kill switch.
AI_DAILY_BUDGET_CENTS=300
AI_DISABLED=0
